{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/skill-enforcement/se07-policy-1.0.schema.json",
  "title": "SE07 skill enforcement policy registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_date",
    "source_of_truth",
    "semantics",
    "skills"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "policy_id": {
      "const": "SE07-skill-enforcement-policy"
    },
    "policy_date": {
      "type": "string",
      "minLength": 10
    },
    "source_of_truth": {
      "type": "string",
      "minLength": 1
    },
    "semantics": {
      "type": "object"
    },
    "skills": {
      "type": "array",
      "minItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill",
          "risk_class",
          "current_level",
          "target_level",
          "scope_mode",
          "rollout_mode",
          "policy_status",
          "rationale",
          "implemented_artifacts",
          "protected_surfaces",
          "known_debt"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "pattern": "^hub-ml-[a-z0-9-]+$"
          },
          "risk_class": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "current_level": {
            "enum": [
              "L0",
              "L1",
              "L2",
              "L3",
              "L4"
            ]
          },
          "target_level": {
            "enum": [
              "L0",
              "L1",
              "L2",
              "L3",
              "L4"
            ]
          },
          "scope_mode": {
            "enum": [
              "whole_skill",
              "stage_specific"
            ]
          },
          "rollout_mode": {
            "enum": [
              "guidance",
              "audit",
              "warn",
              "enforce"
            ]
          },
          "policy_status": {
            "enum": [
              "defined",
              "implemented"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "implemented_artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "protected_surfaces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "level",
                "evidence",
                "rationale"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "level": {
                  "enum": [
                    "L0",
                    "L1",
                    "L2",
                    "L3",
                    "L4"
                  ]
                },
                "evidence": {
                  "enum": [
                    "static",
                    "preflight",
                    "receipt",
                    "postflight",
                    "authorization"
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "known_debt": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
