{
  "$id": "ser-parallel-authorization-1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_command_ids": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "allowed_effects": {
      "items": {
        "enum": [
          "read_only",
          "repo_fixture_write",
          "external_effect"
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "authorization_id": {
      "minLength": 1,
      "type": "string"
    },
    "campaign_id": {
      "type": "string"
    },
    "candidate_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "expires_at_utc": {
      "type": "string"
    },
    "schema_version": {
      "const": "SER-PARALLEL-AUTHORIZATION-1"
    }
  },
  "required": [
    "schema_version",
    "authorization_id",
    "campaign_id",
    "candidate_sha",
    "allowed_command_ids",
    "allowed_effects",
    "expires_at_utc"
  ],
  "type": "object"
}
