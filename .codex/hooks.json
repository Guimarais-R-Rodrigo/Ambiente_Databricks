{
  "description": "SER Autonomous Controller A1 scope guards. Defense in depth; envelope and sandbox remain authoritative.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_scope_guard.py\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$r=(git rev-parse --show-toplevel).Trim(); & (Join-Path $r '.codex\\hooks\\pre_scope_guard.ps1')\"",
            "timeout": 10,
            "statusMessage": "Checking A1 write scope"
          }
        ]
      },
      {
        "matcher": "^(mcp__.*|list_mcp_resources|list_mcp_resource_templates|read_mcp_resource|web__run)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/external_surface_guard.py\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$r=(git rev-parse --show-toplevel).Trim(); & (Join-Path $r '.codex\\hooks\\external_surface_guard.ps1')\"",
            "timeout": 10,
            "statusMessage": "Enforcing SER external tool boundary"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/post_scope_guard.py\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$r=(git rev-parse --show-toplevel).Trim(); & (Join-Path $r '.codex\\hooks\\post_scope_guard.ps1')\"",
            "timeout": 10,
            "statusMessage": "Verifying A1 worktree scope"
          }
        ]
      }
    ]
  }
}
