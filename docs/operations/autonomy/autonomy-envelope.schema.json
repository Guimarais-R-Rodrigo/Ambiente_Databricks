{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ser:autonomy-envelope:1",
  "title": "SER Autonomous Controller Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "front_id",
    "activation",
    "repository",
    "state_source",
    "authority_classes",
    "budgets",
    "human_gates",
    "stop_conditions"
  ],
  "properties": {
    "schema_version": {"const": "SER-AUTONOMY-ENVELOPE-1"},
    "envelope_id": {"type": "string", "minLength": 1},
    "front_id": {"type": "string", "minLength": 1},
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "source_type", "reference", "a2_reference"],
      "properties": {
        "state": {"enum": ["INACTIVE", "ACTIVE_A0_A1", "ACTIVE_A0_A1_A2", "REVOKED"]},
        "source_type": {"enum": ["direct_user_chat", "github_comment", "signed_record"]},
        "reference": {"type": "string", "minLength": 1},
        "a2_reference": {"type": ["string", "null"]}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_name", "branch", "pull_request"],
      "properties": {
        "full_name": {"type": "string"},
        "branch": {"type": "string"},
        "pull_request": {"type": "integer", "minimum": 1}
      }
    },
    "state_source": {"type": "string", "minLength": 1},
    "authority_classes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A0", "A1", "A2", "A3"],
      "properties": {
        "A0": {"$ref": "#/$defs/authorityClass"},
        "A1": {"$ref": "#/$defs/authorityClass"},
        "A2": {"$ref": "#/$defs/authorityClass"},
        "A3": {"$ref": "#/$defs/authorityClass"}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_causal_repair_rounds_per_gate",
        "max_hypotheses_per_root_cause",
        "same_state_same_command_retries",
        "max_unknown_effects_before_human",
        "max_concurrent_subagents",
        "max_write_capable_agents"
      ],
      "properties": {
        "max_causal_repair_rounds_per_gate": {"type": "integer", "minimum": 1},
        "max_hypotheses_per_root_cause": {"type": "integer", "minimum": 1},
        "same_state_same_command_retries": {"const": 0},
        "max_unknown_effects_before_human": {"type": "integer", "minimum": 1},
        "max_concurrent_subagents": {"type": "integer", "minimum": 1},
        "max_write_capable_agents": {"const": 1}
      }
    },
    "human_gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "authorityClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["autonomous", "status", "allowed", "forbidden"],
      "properties": {
        "autonomous": {"type": "boolean"},
        "status": {"type": "string"},
        "allowed": {"type": "array", "items": {"type": "string"}},
        "forbidden": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
