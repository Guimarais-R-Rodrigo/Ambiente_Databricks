{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ser:autonomy-envelope:2",
  "title": "SER Autonomous Controller Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "front_id",
    "activation",
    "repository",
    "state_source",
    "live_state_precedence",
    "repo_scope",
    "authority_classes",
    "budgets",
    "a2_contract",
    "human_gates",
    "stop_conditions"
  ],
  "properties": {
    "schema_version": {"const": "SER-AUTONOMY-ENVELOPE-2"},
    "envelope_id": {"type": "string", "minLength": 1},
    "front_id": {"type": "string", "minLength": 1},
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "source_type", "reference", "a2_reference"],
      "properties": {
        "state": {"enum": ["INACTIVE", "ACTIVE_A0_A1", "ACTIVE_A0_A1_A2", "REVOKED"]},
        "source_type": {"enum": ["direct_user_chat", "github_comment", "signed_record"]},
        "reference": {"type": "string", "minLength": 1},
        "a2_reference": {"type": ["string", "null"]}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_name", "branch", "pull_request"],
      "properties": {
        "full_name": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "pull_request": {"type": "integer", "minimum": 1}
      }
    },
    "state_source": {"type": "string", "minLength": 1},
    "live_state_precedence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "repo_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "write_roots",
        "protected_roots",
        "shared_roots_requiring_human_gate",
        "controller_maintenance_gate"
      ],
      "properties": {
        "write_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "protected_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "shared_roots_requiring_human_gate": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "controller_maintenance_gate": {"const": "CONTROLLER_MAINTENANCE"}
      }
    },
    "authority_classes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A0", "A1", "A2", "A3"],
      "properties": {
        "A0": {"$ref": "#/$defs/authorityClass"},
        "A1": {"$ref": "#/$defs/authorityClass"},
        "A2": {"$ref": "#/$defs/authorityClass"},
        "A3": {"$ref": "#/$defs/authorityClass"}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_causal_repair_rounds_per_gate",
        "max_hypotheses_per_root_cause",
        "same_state_same_command_retries",
        "max_unknown_effects_before_human",
        "max_concurrent_subagents",
        "max_write_capable_agents"
      ],
      "properties": {
        "max_causal_repair_rounds_per_gate": {"type": "integer", "minimum": 1},
        "max_hypotheses_per_root_cause": {"type": "integer", "minimum": 1},
        "same_state_same_command_retries": {"const": 0},
        "max_unknown_effects_before_human": {"type": "integer", "minimum": 1},
        "max_concurrent_subagents": {"type": "integer", "minimum": 1},
        "max_write_capable_agents": {"const": 1}
      }
    },
    "a2_contract": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/a2Contract"}
      ]
    },
    "human_gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "activation": {
            "properties": {"state": {"const": "ACTIVE_A0_A1_A2"}},
            "required": ["state"]
          }
        }
      },
      "then": {
        "properties": {
          "activation": {
            "properties": {"a2_reference": {"type": "string", "minLength": 1}}
          },
          "a2_contract": {"$ref": "#/$defs/a2Contract"}
        }
      }
    }
  ],
  "$defs": {
    "authorityClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["autonomous", "status", "allowed", "forbidden"],
      "properties": {
        "autonomous": {"type": "boolean"},
        "status": {"type": "string", "minLength": 1},
        "allowed": {"type": "array", "items": {"type": "string"}},
        "forbidden": {"type": "array", "items": {"type": "string"}}
      }
    },
    "a2Contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "namespace",
        "allowed_effects",
        "effect_budgets",
        "data_scope",
        "overwrite_allowed",
        "readback_required",
        "unknown_policy",
        "cleanup"
      ],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "host", "workspace_class"],
          "properties": {
            "profile": {"type": "string", "minLength": 1},
            "host": {"type": "string", "minLength": 1},
            "workspace_class": {"type": "string", "minLength": 1}
          }
        },
        "namespace": {"type": "string", "minLength": 1},
        "allowed_effects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "effect_budgets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["effect", "max_attempts"],
            "properties": {
              "effect": {"type": "string", "minLength": 1},
              "max_attempts": {"type": "integer", "minimum": 1}
            }
          }
        },
        "data_scope": {"const": "SYNTHETIC_ONLY"},
        "overwrite_allowed": {"type": "boolean"},
        "readback_required": {"const": true},
        "unknown_policy": {"const": "READ_ONLY_RECONCILE_THEN_HUMAN_IF_UNRESOLVED"},
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "scope"],
          "properties": {
            "allowed": {"type": "boolean"},
            "scope": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
