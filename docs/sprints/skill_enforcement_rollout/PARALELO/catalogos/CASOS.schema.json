{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catálogo de obrigações de planejamento SER paralelo — não é manifesto executável",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "baseline_sha",
    "catalog_kind",
    "launchable",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "plan_id": {
      "const": "SER-PARALLEL-PLAN-2026-09-23"
    },
    "baseline_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "catalog_kind": {
      "const": "PLANNING_OBLIGATIONS_NOT_EXECUTED_TESTS"
    },
    "launchable": {
      "const": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "family",
          "subject",
          "scope",
          "applicability",
          "setup",
          "stimulus_or_mutation",
          "expected_observation",
          "oracle_kind",
          "evidence_required",
          "phase",
          "implementation_status",
          "runtime_status",
          "test_id_bindings",
          "source_basis"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[A-Z]+(?:-G)?[0-9]{2}$"
          },
          "family": {
            "enum": [
              "TRANSVERSAL",
              "MECANISMO",
              "INTEGRACAO",
              "DOMINIO",
              "GENIE"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "applicability": {
            "type": "string",
            "minLength": 1
          },
          "setup": {
            "type": "string",
            "minLength": 1
          },
          "stimulus_or_mutation": {
            "type": "string",
            "minLength": 1
          },
          "expected_observation": {
            "type": "string",
            "minLength": 1
          },
          "oracle_kind": {
            "type": "string",
            "minLength": 1
          },
          "evidence_required": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "type": "string",
            "minLength": 1
          },
          "source_basis": {
            "type": "string",
            "minLength": 1
          },
          "implementation_status": {
            "const": "PLANNED_NOT_IMPLEMENTED"
          },
          "runtime_status": {
            "const": "NOT_RUN"
          },
          "test_id_bindings": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  }
}
