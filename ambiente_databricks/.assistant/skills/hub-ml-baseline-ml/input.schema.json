{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ser:09:request:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","profile","synthetic","requested_effect","population_id","target","positive_class","unit","date_column","feature_order","train_pct","val_pct","gap_periods","period_unit","threshold","seed","rows"],
  "properties": {
    "schema_version": {"const": "SER09-REQUEST-1"},
    "profile": {"const": "BINARY_TEMPORAL_LOCAL_V1"},
    "synthetic": {"const": true},
    "requested_effect": {"const": "NONE"},
    "population_id": {"type": "string", "minLength": 1},
    "target": {"const": "target"},
    "positive_class": {"const": 1},
    "unit": {"type": "string", "minLength": 1},
    "date_column": {"const": "observed_at"},
    "feature_order": {"const": ["feature"]},
    "train_pct": {"const": 0.5},
    "val_pct": {"const": 0.25},
    "gap_periods": {"const": 0},
    "period_unit": {"const": "M"},
    "threshold": {"const": 0.5},
    "seed": {"const": 17},
    "rows": {"type": "array", "minItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["id","observed_at","feature","target"], "properties": {"id": {"type":"string","minLength":1}, "observed_at":{"type":"string","format":"date-time"}, "feature":{"type":"number"}, "target":{"type":"integer","enum":[0,1]}}}}
  }
}
