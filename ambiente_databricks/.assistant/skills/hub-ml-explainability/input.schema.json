{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ser:05:explainability:request:1",
  "description": "Structural shape only. Feature width, IDs, finite values and model binding require preflight and runner.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "SER02-EXPLAINABILITY-REQUEST-1"
    },
    "profile": {
      "const": "LINEAR_REGRESSION_SYNTHETIC_V1"
    },
    "synthetic": {
      "const": true
    },
    "requested_effect": {
      "const": "NONE"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_type": {
          "const": "linear"
        },
        "task": {
          "const": "regression"
        },
        "estimator": {
          "const": "sklearn.LinearRegression"
        },
        "intercept": {
          "type": "number"
        },
        "coefficients": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "model_id",
        "model_type",
        "task",
        "estimator",
        "intercept",
        "coefficients"
      ]
    },
    "feature_names": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "row_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sample_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "X": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "number"
        }
      }
    },
    "background": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "profile",
    "synthetic",
    "requested_effect",
    "model",
    "feature_names",
    "row_ids",
    "sample_ids",
    "X",
    "background"
  ]
}
