{
  "$id": "urn:ser:03:request:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structural shape only. Calendar, roster completeness, cumulative monotonicity and event gaps require preflight.py.",
  "properties": {
    "absence_policy": {
      "const": "MISSING_ROW_NOT_ZERO"
    },
    "cohort_roster": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "originated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "originated_at"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "cutoff": {
      "format": "date-time",
      "type": "string"
    },
    "denominator": {
      "const": "MOB0_UNIQUE_IDS_FIXED_PER_COHORT"
    },
    "duplicate_policy": {
      "const": "REJECT"
    },
    "estimand": {
      "const": "BINARY_CUMULATIVE_INCIDENCE"
    },
    "max_mob": {
      "maximum": 1200,
      "minimum": 0,
      "type": "integer"
    },
    "periodicity": {
      "const": "MONTH"
    },
    "population_id": {
      "minLength": 1,
      "type": "string"
    },
    "profile": {
      "const": "MONTHLY_BINARY_PILOT_V1"
    },
    "requested_effect": {
      "const": "NONE"
    },
    "rows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "mob": {
            "maximum": 1200,
            "minimum": 0,
            "type": "integer"
          },
          "observed_at": {
            "format": "date-time",
            "type": "string"
          },
          "originated_at": {
            "format": "date-time",
            "type": "string"
          },
          "target": {
            "enum": [
              0,
              1
            ],
            "type": "integer"
          }
        },
        "required": [
          "id",
          "mob",
          "observed_at",
          "originated_at",
          "target"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "SER03-REQUEST-1"
    },
    "semantic_mode": {
      "enum": [
        "CUMULATIVE",
        "EVENT"
      ]
    },
    "synthetic": {
      "const": true
    }
  },
  "required": [
    "absence_policy",
    "cohort_roster",
    "cutoff",
    "denominator",
    "duplicate_policy",
    "estimand",
    "max_mob",
    "periodicity",
    "population_id",
    "profile",
    "requested_effect",
    "rows",
    "schema_version",
    "semantic_mode",
    "synthetic"
  ],
  "type": "object"
}
